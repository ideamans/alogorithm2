{
  "name": "alogorithm2",
  "description": "ideaman's Inc logo mark generator v2.",
  "version": "2.7.0",
  "type": "module",
  "typings": "build/index.d.ts",
  "module": "build/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "fix": "run-s fix:*",
    "fix:lint": "eslint --fix",
    "fix:prettier": "prettier --write src",
    "test": "run-s build test:*",
    "test:lint": "eslint src",
    "test:prettier": "prettier src --list-different",
    "test:cspell": "cspell \"{README.md,.github/*.md,src/**/*.ts}\"",
    "test:unit": "c8 --reporter=text-summary ava",
    "watch": "ava --watch",
    "start": "run-s build && node build/start.js",
    "golden:update": "run-s build && UPDATE_GOLDEN=1 ava",
    "docker:smoke": "./scripts/docker-smoke.sh"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@types/node": "^24",
    "@types/sort-json": "^2.0.3",
    "@types/text-to-svg": "^3.1.4",
    "@types/trianglify": "^4.1.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "ava": "^8.4.0",
    "c8": "^12.0.0",
    "cspell": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "standard-version": "^9.5.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "blobs": "^2.3.0-beta.2",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "sharp": "^0.35.5",
    "sort-json": "^2.0.1",
    "svg-path-bbox": "^2.1.0",
    "svg-pathdata": "^9.0.0",
    "svgson": "^5.3.1",
    "text-to-svg": "^3.1.5",
    "trianglify": "^4.1.1"
  },
  "ava": {
    "files": [
      "build/**/*.spec.js"
    ],
    "snapshotDir": "src/snapshots",
    "timeout": "60s",
    "workerThreads": false
  },
  "resolutions": {
    "canvas": "^3.2.3",
    "**/ava/**/glob": "^14.0.2",
    "**/c8/**/glob": "^14.0.2",
    "**/eslint/**/minimatch": "^11.0.1",
    "**/@typescript-eslint/typescript-estree/minimatch": "^11.0.1",
    "**/test-exclude/minimatch": "^11.0.1"
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "printWidth": 120
  }
}
